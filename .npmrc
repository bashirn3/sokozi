auto-install-peers=true

# Mercur requires packages it does not declare — http-proxy-middleware, cors,
# express, jsonwebtoken, multer, @medusajs/core-flows, @medusajs/icons — and
# under pnpm's strict linking each one fails separately at config load. They
# are declared directly in apps/backend/package.json instead of switching this
# workspace to node-linker=hoisted.
#
# Hoisting was tried and rejected. It lifts the backend's React 18 to the
# workspace root, where the storefront's own dependencies resolve it in place
# of the React 19 that Next 15 needs. The result is two React copies and a
# build that dies prerendering /404 with "Cannot read properties of null
# (reading 'useContext')" — a failure that says nothing about its cause.
# Declaring the missing packages is the narrower fix and keeps the two apps
# isolated from each other.
