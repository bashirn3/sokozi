# Copy to apps/storefront/.env.local and fill in. Never commit the filled copy.
# Secret values in this template are intentionally blank.

NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Required. The build hard-exits without it: check-env-variables.js runs at the
# top of next.config.js. Take it from the admin of the backend you are pointing
# at, under Settings, Publishable API Keys. The deployed backend issues a
# different key from your local one.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Two letter Medusa country code. Drives the /tz URL prefix and the fallback
# when the backend cannot be reached.
NEXT_PUBLIC_DEFAULT_REGION=tz

# Digits only, no plus sign, including country code. Example: 255700000000
# Leave blank to hide the WhatsApp action entirely. The placeholder value
# 255700000000 also hides it, so a demo never ships a dead link.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Stripe publishable key. Test key for development.
NEXT_PUBLIC_STRIPE_KEY=

# Optional, only when hosting on Medusa Cloud with S3 backed image uploads.
# Both must be set together or neither is applied.
# MEDUSA_CLOUD_S3_HOSTNAME=
# MEDUSA_CLOUD_S3_PATHNAME=
