# Copy to apps/backend/.env and fill in. Never commit the filled copy.
# Secret values in this template are intentionally blank.

# Local example: postgresql://YOUR_USER@localhost:5432/sokozi
# On Render this is injected from the database resource, do not set it by hand.
DATABASE_URL=

# Generate each with: openssl rand -base64 32
# On Render these are generated by render.yaml, never pasted.
JWT_SECRET=
COOKIE_SECRET=

# Comma separated, no trailing slashes.
# In production these must be the exact deployed origins.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:8000,http://localhost:5173

# Stripe. Test keys for development, live keys are a post-deploy step.
# STRIPE_WEBHOOK_SECRET cannot be issued until the backend has a public URL.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# S3-compatible object storage for admin image uploads, configured for
# Cloudflare R2. Leave every value blank to skip it: no file provider is then
# registered and Medusa falls back to local disk, which is fine locally but
# loses uploads on a container host, since the disk is replaced on each deploy.
#
# The provider registers only when S3_BUCKET is set.
#
# For R2:
#   S3_ENDPOINT   https://<account-id>.r2.cloudflarestorage.com
#   S3_FILE_URL   the bucket's public r2.dev URL, or your own domain
#   S3_REGION     auto
#
# The same settings work against AWS S3 or Backblaze B2, so nothing here ties
# the store to one provider.
S3_BUCKET=
S3_ENDPOINT=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
